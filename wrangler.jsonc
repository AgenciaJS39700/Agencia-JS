{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agencia-js",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": false }
}
